all:
	@echo "CXX arch.cpp"
	@g++ arch.cpp -o build/arch
	@echo "CXX cat.cpp"
	@g++ cat.cpp -o build/cat
	@echo "CXX clear.cpp"
	@g++ clear.cpp -o build/clear
	@echo "CXX ln.cpp"
	@g++ ln.cpp -o build/ln
	@echo "CXX ls.cpp"
	@g++ ls.cpp -o build/ls
	@echo "CXX mkdir.cpp"
	@g++ mkdir.cpp -o build/mkdir
	@echo "CXX mount.cpp"
	@g++ mount.cpp -o build/mount
	@echo "CXX pwd.cpp"
	@g++ pwd.cpp -o build/pwd
	@echo "CXX rm.cpp"
	@g++ rm.cpp -o build/rm
	@echo "CXX rmdir.cpp"
	@g++ rmdir.cpp -o build/rmdir
	@echo "CXX seteuid.cpp"
	@g++ seteuid.cpp -o build/seteuid
	@echo "CXX sleep.cpp"
	@g++ sleep.cpp -o build/sleep
	@echo "CXX uname.cpp"
	@g++ uname.cpp -o build/uname
	@echo "CXX whoami.cpp"
	@g++ whoami.cpp -o build/whoami
	@echo "CXX yes.cpp"
	@g++ yes.cpp -o build/yes
	@echo "Done! Everything is available at build/"

clear:
	@echo "RM build/*"
	@rm -rf build/*

clean:
	@echo "RM build/*"
	@rm -rf build/*
